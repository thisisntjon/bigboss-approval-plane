{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python codex_hook.py --mode approval",
            "commandWindows": "python codex_hook.py --mode approval",
            "timeout": 600,
            "statusMessage": "Waiting for BigBoss approval"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python codex_hook.py --mode update",
            "commandWindows": "python codex_hook.py --mode update",
            "timeout": 30,
            "statusMessage": "Sending BigBoss update"
          }
        ]
      }
    ]
  }
}
